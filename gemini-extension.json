{
  "name": "atlas-annotations",
  "version": "2.0.0-alpha.3",
  "description": "Add and edit Revit dimensions, tags, text and drawing annotations. Requires Atlas Core.",
  "mcpServers": {
    "atlas_annotations": {
      "command": "powershell.exe",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-NonInteractive",
        "-File",
        "${extensionPath}/scripts/atlas-mcp.ps1",
        "-Surface",
        "annotations",
        "-Interface",
        "v2-candidate"
      ]
    }
  }
}
